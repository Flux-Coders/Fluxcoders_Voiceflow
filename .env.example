# ==============================================================================
# VoiceFlow Environment Configuration
# ==============================================================================

# Rime Labs Text-to-Speech (TTS) Configuration
# API Key obtained from https://rime.ai / https://users.rime.ai
RIME_API_KEY=your_rime_api_key_here

# Direct Streaming HTTP Endpoint
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# Model identifier (e.g., mistv3, coda, mistv2)
RIME_MODEL=mistv3

# Speaker / Voice ID from live Rime catalog (e.g., astra, celeste, marsh, amber)
RIME_SPEAKER=astra

# Exact language code required by Rime voice/model (e.g., eng, spa)
RIME_LANGUAGE=eng

# Audio encoding format: pcm, mp3, wav
RIME_AUDIO_FORMAT=pcm

# Sampling rate in Hz: 16000, 22050, 24000
RIME_SAMPLE_RATE=16000

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================

# Active LLM Provider: mock, openai
VOICEFLOW_LLM_PROVIDER=mock

# OpenAI-Compatible API Key
OPENAI_API_KEY=your_openai_api_key_here

# Base URL for OpenAI-compatible endpoint (e.g., https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g., gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature (0.0 to 1.0)
OPENAI_TEMPERATURE=0.1

# HTTP request timeout in seconds
OPENAI_TIMEOUT_SECONDS=15.0